{
	"name": "milu-telemetry",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "dist/host.js",
	"milu": {
		"id": "telemetry",
		"apiVersion": 1,
		"widgets": [
			{
				"id": "telemetry.ball",
				"type": "slot",
