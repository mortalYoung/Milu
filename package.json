{
	"name": "milu",
	"version": "0.0.0",
	"private": true,
	"description": "An agent harness — a local core behind one IPC protocol, rendered by a desktop shell",
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"boundaries": "bun scripts/boundaries.ts",
		"build": "bun run --filter '@milu/desktop' build",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run boundaries",
		"dev": "bun scripts/dev.ts",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"release": "bun scripts/release.ts",
		"start": "bun run --filter '@milu/desktop' start",
		"typecheck": "bun run --filter '*' typecheck"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"typescript": "^7.0.2"
	},
	"trustedDependencies": [
		"electron"
	]
}
