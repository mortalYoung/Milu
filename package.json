{
	"name": "milu",
	"version": "0.0.0",
	"private": true,
	"description": "An agent harness with a server backend — one WebSocket protocol for web and desktop",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"type": "module",
	"scripts": {
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"web:build": "bun run --filter '@milu/web' build",
		"server": "bun run apps/server/src/main.ts",
		"dev:web": "bun run --filter '@milu/web' dev"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"typescript": "^7.0.2"
	}
}
