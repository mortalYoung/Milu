{
	"name": "coding-desktop",
	"version": "0.1.0",
	"description": "A minimal zine-style agent harness desktop app — pi's double loop on Electrobun",
	"scripts": {
		"start": "bun run build:css && bun --env-file=.env x electrobun dev",
		"dev": "bun run build:css && bun --env-file=.env x electrobun dev --watch",
		"dev:css": "bunx @tailwindcss/cli -i src/mainview/style.css -o src/mainview/index.css --content './src/mainview/**/*.{ts,html}' --watch",
		"build:css": "bunx @tailwindcss/cli -i src/mainview/style.css -o src/mainview/index.css --content './src/mainview/**/*.{ts,html}'",
		"build": "bun run build:css && electrobun build",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"format:check": "biome format ."
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/playfair-display": "^5.3.0",
		"electrobun": "1.18.1",
		"lucide": "^1.31.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@tailwindcss/cli": "^4.3.3",
		"@types/bun": "latest",
		"@types/three": "^0.185.4",
		"tailwindcss": "^4.3.3"
	}
}
