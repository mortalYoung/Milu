{
	"name": "milu",
	"version": "0.0.0",
	"private": true,
	"description": "An agent harness with a server backend — one WebSocket protocol for web and desktop",
	"workspaces": [
		"packages/*",
		"packages/extensions/*"
	],
	"type": "module",
	"scripts": {
		"boundaries": "bun scripts/boundaries.ts",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run boundaries",
		"dev": "bun scripts/dev.ts",
		"dev:web": "bun run --filter '@milu/web' dev",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"server": "bun run packages/bootstrap/src/bootstrap-web.ts",
		"typecheck": "bun run --filter '*' typecheck",
		"web:build": "bun run --filter '@milu/web' build"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"typescript": "^7.0.2"
	}
}
