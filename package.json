{
	"name": "milu",
	"type": "module",
	"version": "0.1.0",
	"description": "A minimal FT-styled agent harness desktop app — pi's double loop on Electrobun",
	"scripts": {
		"start": "bun run build:view && bun x electrobun dev",
		"start:log": "mkdir -p .logs && bun run build:view && { echo \"\"; echo \"=== start $(date \"+%Y-%m-%dT%H:%M:%S%z\") ===\"; bun x electrobun dev; } 2>&1 | tee -a \".logs/dev-$(date +%F).log\"",
		"dev": "bun run build:view && bun x electrobun dev --watch",
		"dev:view": "vite build --watch",
		"build": "bun run build:view && electrobun build --env=stable",
		"build:dev": "bun run build:view && electrobun build --env=dev",
		"build:view": "vite build",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"format": "biome check --write .",
		"format:check": "biome check .",
		"icons": "bash scripts/gen-icons.sh"
	},
	"dependencies": {
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.12.4",
		"@codemirror/merge": "^6.12.2",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.5",
		"@codemirror/view": "^6.43.12",
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@shikijs/markdown-it": "^4.4.3",
		"@tanstack/react-virtual": "^3.14.13",
		"chokidar": "^5.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"croner": "^10.0.1",
		"electrobun": "2.0.1",
		"lucide-react": "^1.47.0",
		"markdown-it": "^15.0.0",
		"motion": "^13.4.0",
		"radix-ui": "^1.6.7",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shiki": "^4.4.3",
		"tailwind-merge": "^3.6.0",
		"tree-sitter-wasms": "^0.1.13",
		"tw-animate-css": "^1.4.0",
		"web-tree-sitter": "^0.25.10",
		"yaml": "^2.9.0",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "latest",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/three": "^0.185.4",
		"@vitejs/plugin-react": "6.1.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.1"
	}
}
