{
	"name": "milu",
	"version": "0.2.0",
	"private": true,
	"description": "An agent harness — a local core behind one IPC protocol, rendered by a desktop shell",
	"workspaces": [
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"boundaries": "bun scripts/boundaries.ts",
		"build": "bun scripts/build-mac.ts",
		"check": "bun run typecheck && bun run lint && bun run format:check && bun run boundaries",
		"dev": "bun scripts/dev.ts",
		"ext:build": "bun scripts/ext-build.ts",
		"ext:install": "bun run ext:build && bun scripts/ext-install.ts",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"release": "bun scripts/release.ts",
		"site": "bun scripts/site.ts",
		"site:deploy": "gh-pages -d site -t --nojekyll -m \"site: deploy\"",
		"start": "bun run --filter '@milu/desktop' start",
		"typecheck": "bun run --filter '*' typecheck"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"electron-builder": "^26.18.0",
		"gh-pages": "^6.3.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"typescript": "^7.0.2"
	},
	"trustedDependencies": [
		"electron"
	]
}
