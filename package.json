{
	"name": "coding-desktop",
	"type": "module",
	"version": "0.1.0",
	"description": "A minimal FT-styled agent harness desktop app — pi's double loop on Electrobun",
	"scripts": {
		"start": "bun run build:view && bun --env-file=.env x electrobun dev",
		"dev": "bun run build:view && bun --env-file=.env x electrobun dev --watch",
		"dev:view": "vite build --watch",
		"build": "bun run build:view && electrobun build",
		"build:view": "vite build",
		"typecheck": "tsc --noEmit",
		"test": "bun test",
		"format": "biome check --write .",
		"format:check": "biome check ."
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.84.1",
		"@earendil-works/pi-ai": "0.84.1",
		"@kobalte/core": "^0.13.13",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"electrobun": "1.18.1",
		"lucide-solid": "^1.31.0",
		"solid-js": "^1.9.14",
		"solid-motion": "^1.0.0-alpha.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"overrides": {
		"motion-dom": "12.23.12",
		"motion": "12.23.12",
		"framer-motion": "12.23.12"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "latest",
		"@types/three": "^0.185.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.1",
		"vite-plugin-solid": "^2.11.14"
	}
}
