{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "import", "react"],
	"categories": {
		"correctness": "error",
		"suspicious": "off",
		"pedantic": "off",
		"perf": "off",
		"style": "off",
		"restriction": "off",
		"nursery": "off"
	},
	"rules": {
		"react/rules-of-hooks": "error",
		"react/exhaustive-deps": "warn"
	},
	"ignorePatterns": ["node_modules", "dist", "build", "artifacts", "bun.lock"]
}
