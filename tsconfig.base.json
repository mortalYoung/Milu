{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleDetection": "force",
		"moduleResolution": "bundler",
		// No DOM, on purpose. `target: ESNext` defaults to lib.esnext.full, which drags DOM
		// in and lets backend code touch it by accident. Browser packages opt in themselves.
		"lib": ["ESNext"],
		"allowImportingTsExtensions": true,
		"experimentalDecorators": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noPropertyAccessFromIndexSignature": true,

		// Runtime types belong to each package, never here. The same backend has to run under
		// Electron's Node and under a standalone server, so a Bun-shaped type surface in the
		// base would quietly let Bun-only APIs into code that must run on Node.
		"types": []
	}
}
